# Copia este archivo como .env y cambia los valores. El archivo .env nunca se sube a GitHub.

# Puerto del servidor
PORT=3000

# Conexión a MongoDB. En la nube, usa la cadena de conexión de MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/biblioteca_aurora

# Secreto para firmar los JWT. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Tiempo de vida del token
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS, separados por coma. Vacío = solo el mismo origen.
CORS_ORIGIN=

# Usuario de demostración que crea "npm run seed"
SEED_EMAIL=bibliotecario@aurora.test
SEED_PASSWORD=cambia_esta_contrasena
