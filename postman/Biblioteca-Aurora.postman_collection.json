{
  "info": {
    "name": "Biblioteca Aurora API",
    "description": "Pruebas de la API. Ejecuta la colección completa en orden; define baseUrl para probar otro servidor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datos únicos por ejecución: se puede correr varias veces",
          "if (!pm.collectionVariables.get('email')) {",
          "  const marca = String(Date.now());",
          "  pm.collectionVariables.set('email', `postman${marca}@aurora.test`);",
          "  pm.collectionVariables.set('password', `Prueba-${marca}`);",
          "  pm.collectionVariables.set('isbn', `978${marca.slice(-10)}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "isbn",
      "value": ""
    },
    {
      "key": "token",
